# Reduz o contexto do build (raiz do monorepo) e estabiliza o cache. NÃO exclua
# código-fonte (apps/, packages/, ee/packages) nem .yarn/releases (binário do Yarn).
**/node_modules
.git
**/.meteor/local
**/.turbo
.turbo
**/.yarn/cache
**/.yarn/install-state.gz
**/dist
**/*.log
**/coverage
**/.nyc_output

# Pastas/arquivos não usados pelo build do Meteor (mudá-los não invalida o cache):
docker
docs
.github
.changeset
.devcontainer
.gitpod
.houston
.cursor
.vscode
*.md
