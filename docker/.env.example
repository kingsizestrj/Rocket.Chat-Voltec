# ===== Voltec — configuração de produção (copie para docker/.env) =====

# Domínio público do app (sempre necessário — vira o ROOT_URL).
DOMAIN=chat.suaempresa.com

# Imagem a usar. Deixe o padrão para buildar localmente via Dockerfile.voltec,
# ou aponte para um registry (ex.: ghcr.io/suaempresa/voltec:1.0.0).
VOLTEC_IMAGE=voltec/rocketchat:local

# Versão do MongoDB (7.0 recomendado para esta versão do Rocket.Chat).
MONGODB_VERSION=7.0

# ===== Proxy reverso =====
# Onde publicar a porta do app no host (para proxy externo no MESMO host).
#   127.0.0.1:3000 = só local (padrão, seguro)   |   0.0.0.0:3000 = exposto na rede
ROCKETCHAT_BIND=127.0.0.1:3000
# Nº de proxies reversos na frente (NPM/Traefik = 1).
HTTP_FORWARDED_COUNT=1
# Nome da rede Docker do seu proxy externo (só p/ docker-compose.external-proxy.yml).
PROXY_NETWORK=proxy

# E-mail do TLS — necessário SOMENTE se usar o Traefik embutido (--profile builtin-tls).
TLS_EMAIL=ti@suaempresa.com

# Admin inicial (opcional — cria o usuário no primeiro boot e pula o wizard).
ADMIN_USERNAME=admin
ADMIN_PASS=troque-esta-senha-forte
ADMIN_EMAIL=ti@suaempresa.com

# ===== TURN/WebRTC (coturn) =====
# IP público deste servidor (o coturn anuncia este IP nos candidatos de relay).
TURN_PUBLIC_IP=203.0.113.10
# Credenciais TURN (use as mesmas no Voltec_Call_ICE_Servers do app).
TURN_USER=voltec
TURN_SECRET=troque-esta-senha-turn
# Realm do TURN (normalmente o seu domínio).
TURN_REALM=chat.suaempresa.com
